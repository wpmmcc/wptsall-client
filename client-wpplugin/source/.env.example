# Required: Server connection
WPTSALL_SERVER_BASE=http://127.0.0.1:8787

# Required: Authentication credentials
WPTSALL_EMAIL=your-email@example.com
WPTSALL_PASSWORD=your-secure-password

# Optional: One-shot mode (run once and exit)
# WPTSALL_ONESHOT=true

# Optional: Web UI
# WPTSALL_WEB_UI_BIND=127.0.0.1:8977
# WPTSALL_WEB_UI_PORT=8977

# Optional: Sign plugin
# WPTSALL_SIGN_PLUGIN_PATH=./plugins/wptsall-sign.wasm
