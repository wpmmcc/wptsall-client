# WPTSALL Client E2E 测试配置
# 复制为 .env.test 并填写本机环境值

# WP 插件凭据（机器相关，每台不同）
# 获取方式:
#   cd /var/www/wordpress
#   wp eval 'echo wptsall_get_client_api_token(false);'
#   wp eval 'echo wptsall_get_client_route_secret();'
WP_CLIENT_TOKEN=
ROUTE_SECRET=

# OAuth 账号（Server seed 的 demo 账号）
DEMO_EMAIL=demo@wptsall.dev
DEMO_PASSWORD=demo

# Mock 翻译 API Key（测试环境约定值，不需要改）
MOCK_API_KEY=mock-translate-dev-key-2026

# 服务地址（默认值适合本地开发，一般不需要改）
# CLIENT_BASE=http://127.0.0.1:8977
# MOCK_API_BASE=http://127.0.0.1:9090
